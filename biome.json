{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedPackageJson": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.{css,html,js,json,jsonc,jsx,ts,tsx}",
			"!**/.git",
			"!**/.harpist-data",
			"!**/.output",
			"!**/.wxt",
			"!**/dist",
			"!**/node_modules"
		]
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"javascript": {
		"globals": ["Bun"],
		"jsxRuntime": "reactClassic"
	},
	"linter": {
		"enabled": true
	},
	"root": true,
	"vcs": {
		"clientKind": "git",
		"defaultBranch": "main",
		"enabled": true,
		"useIgnoreFile": true
	}
}
