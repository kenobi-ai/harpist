{
	"name": "harpist-workspace",
	"description": "Record website traffic and prepare API contracts for agents.",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"bridge": "bun run --filter harpist bridge",
		"build": "bun run --filter @harpist/extension build",
		"build:cli": "bun run --filter harpist build",
		"build:firefox": "bun run --filter @harpist/extension build:firefox",
		"check": "bun run compile && bun test ./.pokayoke/rules/*.test.ts ./packages/*/test/*.test.ts && bun run pokayoke check",
		"cli": "bun run --filter harpist harpist",
		"compile": "bun run --workspaces --sequential compile",
		"dev": "bun run --filter @harpist/extension dev",
		"dev:firefox": "bun run --filter @harpist/extension dev:firefox",
		"harpist": "bun run --filter harpist harpist",
		"pack:dry-run": "bun run --filter harpist pack:dry-run",
		"postinstall": "bun run --filter @harpist/extension prepare",
		"publish:check": "bun run check && bun run pack:dry-run",
		"publish:setup": "npm exec --package=npm@latest -- npm trust github harpist --repo kenobi-ai/harpist --file publish.yml --env npm --allow-publish --yes",
		"version:major": "bun run scripts/bump-cli-version.ts major",
		"version:minor": "bun run scripts/bump-cli-version.ts minor",
		"version:patch": "bun run scripts/bump-cli-version.ts patch",
		"version:prerelease": "bun run scripts/bump-cli-version.ts prerelease",
		"zip": "bun run --filter @harpist/extension zip",
		"zip:firefox": "bun run --filter @harpist/extension zip:firefox"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/node": "^26.0.1",
		"pokayoke": "^0.0.6",
		"typescript": "^5.9.3"
	}
}
