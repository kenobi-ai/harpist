{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"include": [
		"files",
		"dependencies",
		"devDependencies",
		"optionalPeerDependencies",
		"unlisted",
		"binaries",
		"unresolved",
		"exports",
		"types",
		"nsExports",
		"nsTypes",
		"duplicates",
		"enumMembers",
		"namespaceMembers",
		"catalog"
	],
	"rules": {
		"binaries": "error",
		"catalog": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"duplicates": "error",
		"enumMembers": "error",
		"exports": "error",
		"files": "error",
		"namespaceMembers": "error",
		"nsExports": "error",
		"nsTypes": "error",
		"optionalPeerDependencies": "error",
		"types": "error",
		"unlisted": "error",
		"unresolved": "error"
	},
	"treatConfigHintsAsErrors": true,
	"treatTagHintsAsErrors": true,
	"workspaces": {
		".": {
			"entry": [".pokayoke/rules/**/*.test.ts", "scripts/**/*.ts"],
			"project": [".pokayoke/rules/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/cli": {
			"entry": ["test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"packages/core": {
			"entry": ["test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"packages/extension": {
			"ignoreUnresolved": ["^#imports$"],
			"project": ["entrypoints/**/*.{ts,tsx}", "lib/**/*.ts"],
			"tailwind": {
				"entry": ["assets/styles.css"]
			}
		}
	}
}
