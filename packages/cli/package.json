{
	"name": "harpist",
	"version": "0.1.0",
	"description": "Record website traffic and prepare API contracts for agents.",
	"keywords": [
		"agents",
		"api",
		"bun",
		"cli",
		"har",
		"openapi"
	],
	"homepage": "https://github.com/kenobi-ai/harpist#readme",
	"bugs": {
		"url": "https://github.com/kenobi-ai/harpist/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenobi-ai/harpist.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"bin": {
		"harpist": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"bridge": "bun run src/cli.ts bridge",
		"build": "bun build src/cli.ts --target=bun --outfile=dist/cli.js '--external=@orpc/*' --external=hono --external=zod",
		"compile": "bun run typecheck",
		"harpist": "bun run src/cli.ts",
		"prepack": "bun run build",
		"pack:dry-run": "bun pm pack --dry-run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@inquirer/prompts": "catalog:",
		"@orpc/contract": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
