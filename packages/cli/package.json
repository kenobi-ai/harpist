{
	"name": "harpist",
	"description": "Record website traffic and prepare API contracts for agents.",
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"harpist": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun build src/cli.ts --target=bun --outfile=dist/cli.js '--external=@orpc/*' --external=hono --external=zod",
		"bridge": "bun run src/cli.ts bridge",
		"compile": "tsc --noEmit -p tsconfig.json",
		"harpist": "bun run src/cli.ts",
		"pack:dry-run": "NPM_CONFIG_CACHE=/private/tmp/harpist-npm-cache npm pack --dry-run",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@orpc/contract": "^1.14.6",
		"@orpc/openapi": "^1.14.6",
		"@orpc/server": "^1.14.6",
		"@orpc/zod": "^1.14.6",
		"hono": "^4.12.27",
		"zod": "^4.4.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"keywords": [
		"agents",
		"api",
		"bun",
		"cli",
		"har",
		"openapi"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenobi-ai/harpist.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/kenobi-ai/harpist/issues"
	},
	"homepage": "https://github.com/kenobi-ai/harpist#readme"
}
