{
	"name": "@harpist/extension",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"compile": "bun run typecheck",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"prepare": "wxt prepare",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox"
	},
	"dependencies": {
		"@harpist/core": "workspace:*",
		"@phosphor-icons/react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@wxt-dev/auto-icons": "catalog:",
		"@wxt-dev/module-react": "catalog:",
		"tailwindcss": "catalog:",
		"wxt": "catalog:"
	}
}
