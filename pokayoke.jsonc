{
  "$schema": "https://pokayoke.codes/schema.json",
  "extends": ["pokayoke/recommended"],
  "localRules": [".pokayoke/rules/**/*.rule.ts"],
  "files": [
    "README.md",
    "skills.sh.json",
    "skills/**/*.md",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".pokayoke/rules/**/*.ts",
    "biome.json",
    "package.json",
    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "tsconfig.json",
    "packages/extension/wxt.config.ts"
  ],
  "ignores": ["**/node_modules/**", "**/dist/**", "**/*.d.ts"],
  "suppressions": {
    "directive": "pokayoke-ignore",
    "requireReason": true,
    "reportUnused": "warn"
  },
  "rules": {
    "repo/no-root-source-files": "error",
    "structure/max-file-lines": ["error", { "max": 350 }]
  },
  "baseline": {
    "structure/max-file-lines": [
      "packages/cli/src/docs.ts:351",
      "packages/cli/src/refine.ts:351",
      "packages/cli/src/replay.ts:351",
      "packages/cli/src/store.ts:351",
      "packages/core/src/bridge-contract.ts:351",
      "packages/core/src/profiles.ts:351",
      "packages/extension/entrypoints/background.ts:351",
      "packages/extension/entrypoints/dashboard/Dashboard.tsx:351",
      "packages/extension/entrypoints/popup/App.tsx:351"
    ]
  }
}
